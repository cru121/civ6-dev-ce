<?xml version="1.0" encoding="utf-8"?>
<!-- Dev CE Playground: an always-visible button panel (new InGame context, no base file replaced).
     Root panel: a visible Grid anchored R,C with the SubContainerSmall2 style, the combination that drew on the map HUD in the FreeGP mod. Control IDs map to Controls.<ID> in the Lua file. -->
<Context>
	<Grid ID="Pg_Frame" Anchor="R,C" Offset="0,0" Size="250,450" Hidden="0" Style="SubContainerSmall2">
		<Stack ID="Pg_Outer" Anchor="C,T" Offset="0,10" StackGrowth="Bottom" StackPadding="4">
			<GridButton ID="Pg_Toggle" Anchor="C,T" Size="226,28" Style="MainButtonSmall" String="Dev CE Playground  [-]"/>

			<Stack ID="Pg_Body" Anchor="C,T" StackGrowth="Bottom" StackPadding="4">
				<Label ID="Pg_Status" Anchor="C,T" Style="FontNormal12" Color="255,236,150,255" WrapWidth="226" String="Dev CE Playground ready."/>

				<Label Anchor="C,T" Style="FontNormal12" Color="200,200,200,255" String="Eras (Dev CE)"/>
				<Stack Anchor="C,T" StackGrowth="Right" StackPadding="4">
					<GridButton ID="Btn_GoldenOn"  Size="111,28" Style="MainButtonSmall" String="Golden ON"/>
					<GridButton ID="Btn_GoldenOff" Size="111,28" Style="MainButtonSmall" String="Golden OFF"/>
				</Stack>
				<Stack Anchor="C,T" StackGrowth="Right" StackPadding="4">
					<GridButton ID="Btn_DarkOn"  Size="111,28" Style="MainButtonSmall" String="Dark ON"/>
					<GridButton ID="Btn_DarkOff" Size="111,28" Style="MainButtonSmall" String="Dark OFF"/>
				</Stack>

				<Label Anchor="C,T" Style="FontNormal12" Color="200,200,200,255" String="Great person (vanilla)"/>
				<GridButton ID="Btn_SpawnJames" Size="226,28" Style="MainButtonSmall" String="Spawn James of St. George"/>

				<Label Anchor="C,T" Style="FontNormal12" Color="200,200,200,255" String="Charges of the selected unit"/>
				<Stack Anchor="C,T" StackGrowth="Right" StackPadding="4">
					<GridButton ID="Btn_VChargePlus"  Size="111,28" Style="MainButtonSmall" String="Vanilla +1"/>
					<GridButton ID="Btn_VChargeMinus" Size="111,28" Style="MainButtonSmall" String="Vanilla -1"/>
				</Stack>
				<Stack Anchor="C,T" StackGrowth="Right" StackPadding="4">
					<GridButton ID="Btn_DChargePlus"  Size="111,28" Style="MainButtonSmall" String="Dev CE +1"/>
					<GridButton ID="Btn_DChargeMinus" Size="111,28" Style="MainButtonSmall" String="Dev CE -1"/>
				</Stack>

				<Label Anchor="C,T" Style="FontNormal12" Color="200,200,200,255" String="Economy (Dev CE)"/>
				<Stack Anchor="C,T" StackGrowth="Right" StackPadding="4">
					<GridButton ID="Btn_FoodPlus"  Size="111,28" Style="MainButtonSmall" String="Capital food +2"/>
					<GridButton ID="Btn_FoodMinus" Size="111,28" Style="MainButtonSmall" String="Capital food -2"/>
				</Stack>
				<Stack Anchor="C,T" StackGrowth="Right" StackPadding="4">
					<GridButton ID="Btn_RoutesPlus"  Size="111,28" Style="MainButtonSmall" String="Routes +1"/>
					<GridButton ID="Btn_RoutesMinus" Size="111,28" Style="MainButtonSmall" String="Routes -1"/>
				</Stack>
			</Stack>
		</Stack>
	</Grid>
</Context>
