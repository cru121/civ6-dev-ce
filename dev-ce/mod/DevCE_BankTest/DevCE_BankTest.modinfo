<?xml version="1.0" encoding="utf-8"?>
<Mod id="8d3f6a52-1b7e-4c90-a2d4-5e9b0c7f1a63" version="1">
	<Properties>
		<Name>Dev CE Bank Test</Name>
		<Teaser>Tests a hand-built Wwise soundbank loaded through UpdateAudio (experimental).</Teaser>
		<Description>EXPERIMENTAL. Ships a soundbank generated by bnktool (no Wwise) with one event, Play_DevCE_BankTest_Beep, and plays it at the start of each of your turns with UI.PlaySound. If you hear a beep, mod-made banks work.</Description>
		<Authors>cru121</Authors>
		<AffectsSavedGames>0</AffectsSavedGames>
		<CompatibleVersions>2.0</CompatibleVersions>
	</Properties>

	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
	</Dependencies>

	<InGameActions>
		<UpdateAudio id="DevCEBankTest_Audio">
			<File>Platforms/Windows/Audio/DevCETestBanks.ini</File>
			<File>Platforms/Windows/Audio/DevCE_Test_Bank.bnk</File>
		</UpdateAudio>
		<AddUserInterfaces id="DevCEBankTest_UI">
			<Properties><Context>InGame</Context></Properties>
			<File>UI/DevCE_BankTest.xml</File>
		</AddUserInterfaces>
	</InGameActions>

	<Files>
		<File>UI/DevCE_BankTest.xml</File>
		<File>UI/DevCE_BankTest.lua</File>
		<File>Platforms/Windows/Audio/DevCETestBanks.ini</File>
		<File>Platforms/Windows/Audio/DevCE_Test_Bank.bnk</File>
	</Files>
</Mod>
