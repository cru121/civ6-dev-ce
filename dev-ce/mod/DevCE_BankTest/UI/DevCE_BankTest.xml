<?xml version="1.0" encoding="utf-8"?>
<!-- Dev CE Bank Test soundboard: always-visible panel (same pattern as the Dev CE Playground: visible Grid with the SubContainerSmall2 style). -->
<Context>
	<Grid ID="Sb_Frame" Anchor="L,B" Offset="0,60" Size="250,470" Hidden="0" Style="SubContainerSmall2">
		<Stack ID="Sb_Outer" Anchor="C,T" Offset="0,10" StackGrowth="Bottom" StackPadding="4">
			<Label Anchor="C,T" Style="FontNormal14" Color="255,236,150,255" String="Dev CE Soundboard"/>
			<Label ID="Sb_Status" Anchor="C,T" Style="FontNormal12" Color="150,220,255,255" WrapWidth="226" String="Pick a sound or type an event name."/>

			<Label Anchor="C,T" Style="FontNormal12" Color="200,200,200,255" String="Our hand-built bank"/>
			<GridButton ID="Sb_Beep" Size="226,28" Style="MainButtonSmall" String="BEEP (Play_DevCE_BankTest_Beep)"/>

			<Label Anchor="C,T" Style="FontNormal12" Color="200,200,200,255" String="Game sounds (to compare)"/>
			<GridButton ID="Sb_Alert" Size="226,28" Style="MainButtonSmall" String="Game alert"/>
			<GridButton ID="Sb_Click" Size="226,28" Style="MainButtonSmall" String="Play_UI_Click"/>
			<GridButton ID="Sb_Open" Size="226,28" Style="MainButtonSmall" String="UI_Screen_Open"/>
			<GridButton ID="Sb_Lens" Size="226,28" Style="MainButtonSmall" String="UI_Lens_Overlay_On"/>
			<GridButton ID="Sb_Tray" Size="226,28" Style="MainButtonSmall" String="Tech_Tray_Slide_Open"/>
			<GridButton ID="Sb_Music" Size="226,28" Style="MainButtonSmall" String="Music: Play_Music_Japan"/>
			<GridButton ID="Sb_Stop" Size="226,28" Style="MainButtonSmall" String="Stop_All"/>

			<Label Anchor="C,T" Style="FontNormal12" Color="200,200,200,255" String="Any event name (Enter or Play)"/>
			<Box Size="226,22" Color="0,0,0,200">
				<EditBox ID="Sb_Edit" Anchor="C,C" Offset="1,0" Size="parent-8,16" MaxLength="80" KeepFocus="0" Style="FontNormal14" Color0="208,212,217,255" Color1="16,43,67,100" CursorColor="194,194,204"/>
			</Box>
			<GridButton ID="Sb_PlayTyped" Size="226,28" Style="MainButtonSmall" String="Play typed event"/>
		</Stack>
	</Grid>
</Context>
