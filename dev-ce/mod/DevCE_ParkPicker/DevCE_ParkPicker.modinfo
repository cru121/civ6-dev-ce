<?xml version="1.0" encoding="utf-8"?>
<Mod id="c2a9d4e1-5b37-4f60-9a18-7e3b6d0f4c52" version="1">
	<Properties>
		<Name>Dev CE Custom National Park (experimental)</Name>
		<Teaser>A second Naturalist button: pick the tiles of a National Park yourself.</Teaser>
		<Description>EXPERIMENTAL, SINGLE PLAYER ONLY. Adds a button next to the Naturalist's actions. Click it, the tiles that can be part of a National Park light up green (tiles you already picked are yellow); click touching tiles of the same city (the number comes from the park rules, four by default; click the last tile again to finish early); the park appears with exactly that shape. Adds world wonders and the Preserve district to the park rules, which also changes the vanilla action and the AI. Right-click undoes the last tile or cancels. The normal "Designate National Park" action is not replaced. Needs the Dev CE GameCore mod (0.5.0 or newer, only one GameCore mod enabled) and DevCE_ParkRules. Without it the button stays hidden.</Description>
		<Authors>cru121</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<AffectsSavedGames>0</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
		<Mod id="7d41e0a6-92c3-4b58-8f1e-3a5c60d92b17" title="Dev CE National Park Rules (experimental)" />
	</Dependencies>
	<LocalizedText>
		<Text id="LOC_DCP_BUTTON_TOOLTIP">
			<en_US>Designate a custom National Park: pick the tiles yourself (Dev CE).</en_US>
		</Text>
	</LocalizedText>
	<InGameActions>
		<UpdateDatabase id="DCP_SQL">
			<File>Sql/DevCE_ParkPicker.sql</File>
		</UpdateDatabase>
		<AddUserInterfaces id="DCP_UI">
			<Properties><Context>InGame</Context></Properties>
			<File>UI/DevCE_ParkPicker.xml</File>
		</AddUserInterfaces>
		<AddGameplayScripts id="DCP_GP">
			<File>Scripts/DevCE_ParkPicker_GP.lua</File>
		</AddGameplayScripts>
	</InGameActions>
	<Files>
		<File>Sql/DevCE_ParkPicker.sql</File>
		<File>UI/DevCE_ParkPicker.xml</File>
		<File>UI/DevCE_ParkPicker.lua</File>
		<File>Scripts/DevCE_ParkPicker_GP.lua</File>
	</Files>
</Mod>
