<?xml version="1.0" encoding="utf-8"?>
<Mod id="29a41227-6b23-4287-8f49-a2b2436321d0" version="1">
	<Properties>
		<Name>Dev CE Gold Purchase Unlocks (experimental)</Name>
		<Teaser>Lists build-only units and buildings for gold where a city property unlocks them (needs Dev CE).</Teaser>
		<Description>EXPERIMENTAL, SINGLE PLAYER ONLY. With the Dev CE GameCore mod, a unit or building without a PurchaseYield (build only; wonders excluded) can be bought with gold in a city whose property DEVCE_GOLD_PURCHASE_&lt;UnitType / PromotionClass / BuildingType / PrereqDistrict&gt;, DEVCE_GOLD_PURCHASE_ALL_UNITS or DEVCE_GOLD_PURCHASE_ALL_BUILDINGS is 1 or more (MODIFIER_SINGLE_CITY_ADJUST_PROPERTY, or EFFECT_ADJUST_CITY_PROPERTY with COLLECTION_PLAYER_CITIES). The engine rule and the AI come with the Dev CE GameCore mod; this mod adds those items to the gold purchase list of the production panel. It replaces ProductionPanel (it includes the base panel and only wraps GetData). With CQUI it uses a variant that includes CQUI's panel instead (chosen automatically). Other ProductionPanel replacements (BBG, Babylon Heroes mode) are not combined: add a variant file that includes theirs before UI/DevCE_GoldPurchase_Wrap.lua.</Description>
		<Authors>Dev CE</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
	</Dependencies>
	<ActionCriteria>
		<Criteria id="CQUI">
			<ModInUse>1d44b5e7-753e-405b-af24-5ee634ec8a01</ModInUse>
		</Criteria>
	</ActionCriteria>
	<InGameActions>
		<UpdateDatabase id="DCGP_SQL">
			<File>Sql/DevCE_GoldPurchase.sql</File>
		</UpdateDatabase>
		<ImportFiles id="DCGP_WRAP">
			<Properties>
				<LoadOrder>-10</LoadOrder>
			</Properties>
			<Items>
				<File>UI/DevCE_GoldPurchase_Wrap.lua</File>
			</Items>
		</ImportFiles>
		<ReplaceUIScript id="DCGP_ProductionPanel">
			<Properties>
				<LuaContext>ProductionPanel</LuaContext>
				<LuaReplace>UI/ProductionPanel_DevCE_GoldPurchase.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<!-- with CQUI: replaces CQUI's replacement (LoadOrder 10) and includes it -->
		<ReplaceUIScript id="DCGP_ProductionPanel_CQUI" criteria="CQUI">
			<Properties>
				<LoadOrder>11</LoadOrder>
				<LuaContext>ProductionPanel</LuaContext>
				<LuaReplace>UI/ProductionPanel_DevCE_GoldPurchase_CQUI.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
	</InGameActions>
	<Files>
		<File>Sql/DevCE_GoldPurchase.sql</File>
		<File>UI/DevCE_GoldPurchase_Wrap.lua</File>
		<File>UI/ProductionPanel_DevCE_GoldPurchase.lua</File>
		<File>UI/ProductionPanel_DevCE_GoldPurchase_CQUI.lua</File>
	</Files>
</Mod>
